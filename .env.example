# PROJECTIQ environment configuration
# Copy this file to .env and add your own credentials. Never commit .env.

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Optional GitHub token for repository metadata
GITHUB_TOKEN=

# Local SQLite database (default)
DATABASE_URL=sqlite:///storage/projectiq.db
MAX_UPLOAD_MB=100

# Chat generation
CHAT_TEMPERATURE=0.3
CHAT_MAX_OUTPUT_TOKENS=1200
