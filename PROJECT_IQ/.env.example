# ============================================================
# PROJECTIQ - Environment Configuration
# Copy this file to ".env" and fill in your own values.
# Never commit your real ".env" file to version control.
# ============================================================

# Required for the AI Chatbot, RAG explanations, and LLM-assisted
# recommendation writing. Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional. Only required if you want ProjectIQ to pull repository
# metadata directly from GitHub (stars, language stats, topics).
# Create one at https://github.com/settings/tokens (no special scopes needed
# for public repositories).
GITHUB_TOKEN=

# Local database connection string.
# SQLite is used by default. Swap this for a PostgreSQL URL later, e.g.
# postgresql+psycopg2://user:password@localhost:5432/projectiq
DATABASE_URL=sqlite:///storage/projectiq.db

# Maximum accepted upload size for a project ZIP file, in megabytes.
MAX_UPLOAD_MB=100
